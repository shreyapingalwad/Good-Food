# MessSaver Frontend Environment Configuration
# Copy this file to .env or .env.local for development.
# Only variables prefixed with VITE_ are exposed to client-side code.
# NEVER put private API secrets, database passwords, or signing keys here.

# API Base URL (empty string enables Vite proxy /api -> backend)
# Set to full URL if hosting backend on separate origin (e.g., https://api.messaver.edu)
VITE_API_BASE_URL=
