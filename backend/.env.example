# MessSaver Backend Environment Configuration
# Copy this file to backend/.env and adjust variables for your local or production environment.
# DO NOT commit real secrets or production passwords to version control.

# Application Environment (development | staging | production)
ENVIRONMENT=development
PROJECT_NAME="MessSaver Operational Backend"
DEBUG=false

# Authoritative Operational Database URL (PostgreSQL)
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg://postgres:your_secure_password@localhost:5432/messaver_db

# Optional Test Database URL (SQLite or dedicated PostgreSQL test instance)
# TEST_DATABASE_URL=sqlite:///./test_messaver.db

# API Host & Port for Local Server
API_HOST=127.0.0.1
API_PORT=8000

# CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Reverse Proxy Trusted IP List
TRUSTED_PROXIES=["127.0.0.1","::1"]

# Server-Side Session Signing Secret (REQUIRED in production, >= 32 characters)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SESSION_SECRET=

# CSRF Token Signing Secret (REQUIRED in production, >= 32 characters)
CSRF_SECRET=

# Server-Side Pickup PIN Pepper (REQUIRED in production, >= 16 characters)
# Must be kept secret outside the database and source control
PIN_PEPPER=

# Shared Redis Cache/Rate-Limiting (Required for multi-worker production deployments)
REDIS_URL=redis://localhost:6379/0
REDIS_FALLBACK_TO_MEMORY=true

# Security Timing Controls (Seconds)
SESSION_MAX_AGE_SECONDS=28800
SESSION_IDLE_TIMEOUT_SECONDS=1800
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
ACCOUNT_LOCKOUT_THRESHOLD=8
ACCOUNT_LOCKOUT_DURATION_SECONDS=1800
PIN_LOCKOUT_MAX_ATTEMPTS=3
PIN_LOCKOUT_WINDOW_SECONDS=900
