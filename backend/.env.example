# MessSaver Backend Environment Configuration
# Copy this file to .env and adjust variables for your local or production environment.
# DO NOT commit real secrets or passwords to version control.

# Application Environment (development | staging | production)
ENVIRONMENT=development
PROJECT_NAME="MessSaver Operational Backend"
DEBUG=false

# Authoritative Operational Database URL (PostgreSQL)
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg://postgres:your_secure_password@localhost:5432/messaver_db

# Optional Test Database URL (SQLite or PostgreSQL test instance)
# TEST_DATABASE_URL=sqlite:///./test_messaver.db

# API Host & Port for Local Development
API_HOST=127.0.0.1
API_PORT=8000
