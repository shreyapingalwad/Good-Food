{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://good-food-gqja.onrender.com/api/:path*"
    },
    {
      "source": "/health/:path*",
      "destination": "https://good-food-gqja.onrender.com/health/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://good-food-gqja.onrender.com/auth/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
